                "#| echo: false \n",
                "\n",
                "using CairoMakie;"
            ],
            "outputs": [
            ],
            "execution_count": 1
        },
        {
            "id": "3",
            "cell_type": "markdown",
            "metadata": {
            },
            "source": [
                "\n",
                "# General Julia Set"
            ]
        },
        {
            "id": "4",
            "cell_type": "code",
            "metadata": {
            },
            "source": [
                "# const C_VAL = complex(-0.7, 0.25)\n",
                "const C_VAL = complex(-0.512511498387847167, 0.521295573094847167)\n",
                "const MAX_ITER = 1000\n",
                "const ESCAPE_RADIUS_SQ = 4.0;"
            ],
            "outputs": [
            ],
            "execution_count": 1
        },
        {
            "id": "5",
            "cell_type": "markdown",
            "metadata": {
            },
            "source": [
            ]
        },
        {
            "id": "6",
            "cell_type": "code",
            "metadata": {
            },
            "source": [
                "function jul(x, y; c=C_VAL, n=2.0)\n",
                "    z = complex(x, y)\n",
                "    for i in 1:MAX_ITER\n",
                "        if abs2(z) > ESCAPE_RADIUS_SQ \n",
                "            return Float64(i)\n",
                "        end\n",
                "        z = z^n + c \n",
                "    end\n",
                "    return NaN\n",
                "end;"
            ],
            "outputs": [
            ],
            "execution_count": 1
        },
        {
            "id": "7",
            "cell_type": "markdown",
            "metadata": {
            },
            "source": [
            ]
        },
        {
            "id": "8",
            "cell_type": "code",
            "metadata": {
            },
            "source": [
                "function plot_julia_set(set_func, name;\n",
                "                        xlims=(-1.5, 1.5), ylims=(-1.0,1.0), res=1e-3,\n",
                "                        title = \"Julia Set with c=$(round(C_VAL, digits=4))\"\n",
                "                        )\n",
                "    xmin, xmax = xlims \n",
                "    ymin, ymax = ylims\n",
                "\n",
                "    res = 1e-3\n",
                "    xs = xmin:res:xmax\n",
                "    ys = ymin:res:ymax\n",
                "\n",
                "    inch = 96\n",
                "    pt = 4/3\n",
                "\n",
                "    fig = Figure(size=(10inch, 7inch), fontsize=12pt)\n",
                "\n",
                "    Label(fig[1,1],\n",
                "        title, \n",
                "        tellwidth=false)\n",
                "\n",
                "    ax = Axis(fig[2,1],\n",
                "            xlabel = \"Re(z)\",\n",
                "            ylabel = \"Im(z)\",\n",
                "            xticks = xmin:0.5:xmax,\n",
                "            yticks = ymin:0.25:ymax,\n",
                "            aspect = DataAspect()\n",
                "            )\n",
                "\n",
                "    hm = heatmap!(ax, xs, ys, set_func,\n",
                "            colormap = :inferno,\n",
                "            colorscale = log10,\n",
                "            nan_color = \"black\",\n",
                "            rasterize=4.0)\n",
                "\n",
                "    save(name, fig)\n",
                "end;"
            ],
            "outputs": [
            ],
            "execution_count": 1
        },
        {
            "id": "9",
            "cell_type": "markdown",
            "metadata": {
            },
            "source": [
            ]
        },
        {
            "id": "10",
            "cell_type": "code",
            "metadata": {
            },
            "source": [
                "with_theme(theme_latexfonts()) do \n",
                "    plot_julia_set(jul, \"images/julia_set.svg\")\n",
                "end;"
            ],
            "outputs": [
            ],
            "execution_count": 1
        },
        {
            "id": "11",
            "cell_type": "markdown",
            "metadata": {
            },
            "source": [
                "\n",
                "![Julia set with \\-0\\.5125114983878472 \\+ 0\\.5212955730948472im ](images/julia_set.svg){#fig-set width=90%}\n",
                "\n",
                "# Mandelbrot Set"
            ]
        },
        {
            "id": "12",
            "cell_type": "code",
            "metadata": {
            },
            "source": [
                "mandelbrot(x, y) = jul(x, y; c = complex(x, y));"
            ],
            "outputs": [
            ],
            "execution_count": 1
        },
        {
            "id": "13",
            "cell_type": "markdown",
            "metadata": {
            },
            "source": [
            ]
        },
        {
            "id": "14",
