            "metadata": {
            },
            "source": [
                "with_theme(theme_latexfonts()) do \n",
                "    plot_julia_set(mandelbrot, \"images/mandelbrot_set.svg\";\n",
                "                    xlims = (-2.0, 1.0),\n",
                "                    ylims = (-1.1, 1.1),\n",
                "                    title = \"Mandelbrot Set\"\n",
                "                  )\n",
                "end;"
            ],
